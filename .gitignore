build/

# Vendor packages downloaded for reference. Kept out of git on purpose: they
# carry no licence, so they can be read but not redistributed.
# See README section "References and prior art" for where they come from.
vendor-reference/

# SDCC intermediates, in case anyone builds in-tree
*.asm
*.ihx
*.hex
*.lst
*.map
*.mem
*.rel
*.rst
*.sym
*.lk
*.adb
*.cdb

# ...except under examples/, where the built artefacts ARE the deliverable.
# The bundles are what the circuit designer, both emulators and the debug
# monitor consume, so they are committed rather than regenerated: a consumer
# in another repo must not need SDCC and a stc-compiler checkout to open an
# example. Rebuild with `make examples`.
!examples/**/*.hex
!examples/**/*.cdb

.DS_Store

# Agent context: local paths and operational detail, not for the repo.
CLAUDE.md

# Python bytecode from tools/ (live-monitor.py is imported by the emulator harnesses)
__pycache__/
*.pyc
